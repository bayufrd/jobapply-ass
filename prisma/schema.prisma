generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  draft
  ready
  running
  paused
  stopped
  completed
  error
}

enum SubmitMode {
  assisted_auto_apply
  manual_review_only
}

enum JobListingStatus {
  discovered
  skipped
  shortlisted
  applying
  submitted
  failed
  apply_unavailable
}

enum ApplicationStatus {
  pending_review
  approved
  skipped
  submitted
  failed
  paused
}

enum LogLevel {
  info
  warn
  error
}

model CandidateProfile {
  id                 String   @id @default(cuid())
  fullName           String?
  email              String?
  phone              String?
  location           String?
  summary            String?
  skillsJson         String?
  experienceJson     String?
  educationJson      String?
  projectsJson       String?
  certificationsJson String?
  rawCvText          String?
  sourceType         String?  @default("uploaded_file")
  manualTextUsed     Boolean  @default(false)
  sourceUploadedCvId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model UploadedCV {
  id             String   @id @default(cuid())
  fileName       String
  fileType       String
  filePath       String
  extractedText  String?
  sourceType     String?  @default("uploaded_file")
  manualTextUsed Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Campaign {
  id                    String                 @id @default(cuid())
  name                  String
  keyword               String
  location              String?
  targetApplyCount      Int                    @default(1)
  appliedCount          Int                    @default(0)
  status                CampaignStatus         @default(draft)
  submitMode            SubmitMode             @default(assisted_auto_apply)
  matchThreshold        Int                    @default(70)
  defaultCurrentSalary  Int                    @default(6000000)
  defaultExpectedSalary Int                    @default(6000000)
  defaultNoticePeriod   String                 @default("ASAP")
  defaultAvailability   String                 @default("Immediate")
  workModePreference    String?
  currentJobTitle       String?
  currentJobCompany     String?
  automationMode        String                 @default("review_each_application")
  lowScoreMode          String                 @default("ask")
  autoSubmitSafeOnly    Boolean                @default(false)
  currentStep           String?
  currentJobId          String?
  currentQuestion       String?
  decisionStatus        String?
  decisionPayloadJson   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  applications          Application[]
  jobListings           JobListing[]
  logs                  AutomationLog[]
  decisionRules         CampaignDecisionRule[]
}

model JobListing {
  id           String           @id @default(cuid())
  campaignId   String?
  source       String           @default("jobstreet")
  title        String
  company      String
  location     String?
  salaryText   String?
  workType     String?
  url          String           @unique
  description  String?
  snippet      String?
  matchScore   Int?
  matchReason  String?
  status       JobListingStatus @default(discovered)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  campaign      Campaign?               @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  applications  Application[]
  calibrations  ApplicationCalibration[]
  logs          AutomationLog[]
}

model Application {
  id             String            @id @default(cuid())
  campaignId     String
  jobListingId   String
  status         ApplicationStatus @default(pending_review)
  submitMode     SubmitMode        @default(assisted_auto_apply)
  submittedAt    DateTime?
  skippedReason  String?
  userApproved   Boolean           @default(false)
  screenshotPath String?
  notes          String?
  answersJson    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  campaign       Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  jobListing     JobListing        @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
}

model QuestionMemory {
  id                 String   @id @default(cuid())
  questionRaw        String
  questionNormalized String   @unique
  answer             String
  source             String
  confidence         Float
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AutomationLog {
  id           String      @id @default(cuid())
  campaignId   String?
  jobListingId String?
  level        LogLevel    @default(info)
  event        String
  message      String
  metadataJson String?
  createdAt    DateTime    @default(now())
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  jobListing   JobListing? @relation(fields: [jobListingId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([jobListingId, createdAt])
}

model BrowserSession {
  id            String    @id @default(cuid())
  provider      String    @unique
  sessionPath   String
  isValid       Boolean   @default(false)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UserSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationCalibration {
  id                    String     @id @default(cuid())
  jobListingId          String
  campaignId            String?
  flowType              String?    @default("unknown")
  platform              String?    @default("unknown")
  currentUrl            String?
  pageTitle             String?
  detectedFieldsJson    String?
  detectedQuestionsJson String?
  detectedButtonsJson   String?
  submitCandidatesJson  String?
  screenshotPath        String?
  status                String     @default("pending")
  notes                 String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  jobListing            JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@index([jobListingId, createdAt])
}

model CampaignDecisionRule {
  id          String   @id @default(cuid())
  campaignId  String
  type        String
  patternText String
  action      String
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
}
