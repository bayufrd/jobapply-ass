# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent config
.roo/
/prisma/dev.db
prisma/dev.db

# storage files (private data)
storage/cv/*
storage/screenshots/*
storage/jobstreet.auth.json
storage/logs/*.log
storage/logs/*.jsonl
.mcp-browser-profile/
.playwright-browser-profile/

# keep storage directories
!storage/cv/.gitkeep
!storage/screenshots/.gitkeep
/storage/
/storage/*
storage/
.mcp-output/
tests/layout/*.apk
.playwright-mcp/
/.playwright-mcp/
